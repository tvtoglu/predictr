# predictr custom matplotlib style
# Based on matplotlib's built-in 'fivethirtyeight' style, tuned for
# presentation- and documentation-friendly Weibull plots (predictr).
#
# Usage (does NOT interfere with other matplotlib styles):
#   plt.style.use('src/predictr.mplstyle')
# or pass the path directly to predictr:
#   Analysis(df, ..., plot_style='src/predictr.mplstyle')
#
# To register it globally as a named style ('predictr'), copy this file to
# matplotlib.get_configdir() + '/stylelib/predictr.mplstyle'.

lines.linewidth: 4
lines.solid_capstyle: butt

legend.fancybox: true
legend.frameon: true
legend.facecolor: f7f7f7
legend.edgecolor: bababa
legend.framealpha: 0.9
legend.borderpad: 0.5
legend.title_fontsize: 10.0

axes.prop_cycle: cycler('color', ['008fd5', 'fc4f30', 'e5ae38', '6d904f', '8b8b8b', '810f7c'])
axes.facecolor: fefefe
axes.labelsize: 12
axes.axisbelow: true
axes.grid: true
axes.edgecolor: c7c7c7
axes.linewidth: 1.0
axes.titlesize: x-large
axes.titlepad: 15.0
axes.labelpad: 8.0

patch.edgecolor: f0f0f0
patch.linewidth: 0.5

svg.fonttype: path

grid.linestyle: -
grid.linewidth: 1.0
grid.color: c7c7c7

# Ticks sichtbar (im Unterschied zu fivethirtyeight, dort auf 0 gesetzt),
# damit die Markierungen genau an den Beschriftungspositionen erscheinen.
xtick.major.size: 5
xtick.major.width: 1.2
xtick.major.pad: 6
xtick.minor.size: 3
xtick.minor.width: 0.8
xtick.minor.visible: False
xtick.color: 333333
xtick.labelsize: 10

ytick.major.size: 5
ytick.major.width: 1.2
ytick.major.pad: 6
ytick.minor.size: 0
ytick.color: 333333
ytick.labelsize: 10

font.size: 11.0

figure.subplot.left: 0.08
figure.subplot.right: 0.95
figure.subplot.bottom: 0.07
figure.facecolor: ffffff
figure.dpi: 120

savefig.dpi: 300
